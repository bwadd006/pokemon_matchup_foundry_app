{
  "name": "pokemon_matchup_foundry_app",
  "productName": "Pokémon Matchup Foundry",
  "version": "0.1.0-alpha.1",
  "description": "Unofficial generation-aware Pokémon Pokédex and matchup analysis desktop app",
  "main": ".webpack/main",
  "private": true,
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "data:download": "tsx scripts/database/download_source_data.ts",
    "data:build": "tsx scripts/database/build_database.ts",
    "data:validate": "tsx scripts/database/validate_database.ts",
    "assets:import": "tsx scripts/assets/import_sprites.ts",
    "test": "vitest run --config vitest_config.mts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "author": "Pokémon Matchup Foundry contributors",
  "license": "MIT",
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron-forge/plugin-webpack": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "@vercel/webpack-asset-relocator-loader": "^1.7.3",
    "css-loader": "^6.11.0",
    "electron": "44.3.0",
    "eslint": "^8.57.1",
    "eslint-plugin-import": "^2.32.0",
    "fork-ts-checker-webpack-plugin": "^7.3.0",
    "node-loader": "^2.1.0",
    "style-loader": "^3.3.4",
    "ts-loader": "^9.6.2",
    "tsx": "^4.23.13",
    "typescript": "5.9.3",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "electron-squirrel-startup": "^1.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": false,
    "esbuild@0.28.2": true,
    "electron-winstaller@5.4.4": true
  },
  "config": {
    "forge": "./forge_config.ts"
  }
}
